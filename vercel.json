{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/consultation",
      "destination": "/book"
    },
    {
      "source": "/chat",
      "destination": "/book"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-quick",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
